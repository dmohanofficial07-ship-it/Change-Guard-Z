{
  "name": "diffharbor-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "migrate:local": "wrangler d1 migrations apply diffharbor --local --config wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply diffharbor --remote --config wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
