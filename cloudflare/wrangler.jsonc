{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diffharbor-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diffharbor",
      "database_id": "f2f289f8-32fc-46bb-b2b6-c55a96a05a31",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "RUN_QUEUE", "queue": "diffharbor-runs" }],
    "consumers": [
      {
        "queue": "diffharbor-runs",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "diffharbor-runs-dlq"
      }
    ]
  },
  "vars": {
    "APP_PUBLIC_URL": "https://diffharbor-live.diffharbor-cloudflare.workers.dev",
    "GITHUB_WORKFLOW_FILE": "changeguard.yml"
  }
}
