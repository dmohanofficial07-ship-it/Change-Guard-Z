# Copy this file to .env in the backend directory for local development.
# Keep the real .env file private; never commit app keys or webhook secrets.
DATABASE_URL=postgresql+asyncpg://changeguard:changeguard@localhost:5432/changeguard
REDIS_URL=redis://localhost:6379/0
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=false
CHANGEGUARD_PUBLIC_URL=
GITHUB_WORKFLOW_FILE=changeguard.yml
FRONTEND_ORIGIN=http://localhost:5173
